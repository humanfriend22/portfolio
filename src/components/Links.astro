---
// <Links title="Check these out" />: renders src/data/links.ts as link cards; nothing if it is empty
import { links } from '../data/links';

interface Props { title?: string }
const { title } = Astro.props;
---
{links.length > 0 && (
  <>
    {title && <h2 id={title.toLowerCase().replace(/[^a-z0-9]+/g, '-')} class="section-heading">{title}</h2>}
    <div class="card-grid">
      {links.map((l) => (
        <a class="card" href={l.url} target="_blank" rel="noopener noreferrer">
          <span class="card-title">{l.title} ↗</span>
          {l.note && <span class="card-summary">{l.note}</span>}
          <span class="card-stack">{new URL(l.url).host}</span>
        </a>
      ))}
    </div>
  </>
)}
