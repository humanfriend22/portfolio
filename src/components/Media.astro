---
// <Media src="pic" alt="..." side="left|right" caption="...">markdown text</Media>: src is optional; without it the text just fills the row.
// src is an image name, no extension: src="mentor1" (must be unique under src/content, or give enough of the path).
import { Image } from 'astro:assets';
import { findImage, imgProps } from '../lib/images';

interface Props { src?: string; alt?: string; side?: 'left' | 'right'; caption?: string }
const { src, alt = '', side = 'left', caption } = Astro.props;
---
<div class="media" data-side={side}>
  {src && (
    <figure class="media-figure">
      <Image {...imgProps(findImage(src))} alt={alt} widths={[400, 800]} sizes="(min-width: 768px) 400px, 100vw" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )}
  <div class="media-text"><slot /></div>
</div>
