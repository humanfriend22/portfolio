---
// <Card title="Dave Maino" subtitle="Honors DE" date="2026-09-19" image="davemaino" href="/projects/x" tags={['ESP32']} align="horizontal">text</Card>
// One card for everything: a project, a person, a link, or an image beside some text. Anything left out is not shown.
//   image: an image name, or a list of them (first is the cover, the rest stack under it). Trims work: "photo?bottom=25"
//   date: a date (2026-09-19, shown formatted) or any text ("Nov 13 – Nov 26, 2023")   subtitle: a line under the title (a course, a role)
//   href: makes the whole card a link   links: [{ text, href }] small links under the subtitle   id: anchor for #links
//   align: vertical (image on top, default) | horizontal (image beside the text on desktop)   side: right puts that image after the text
//   bare: no box around it (plain image + text)   prose: the body is long-form text, shown at normal size with headings and lists
//   indent: indent the first line of the body's paragraphs (true) or not (false). Left out, it follows the page's `indent`.
//   The text between the tags is the body (Markdown works). Put cards inside <Grid cols={2}> to lay them out.
import { Image } from 'astro:assets';
import { findImage, imgProps, type Pic } from '../lib/images';
import { externalAttrs } from '../lib/external';
import { formatDate } from '../lib/projects';
import { url } from '../lib/url';
import Gallery from './Gallery.astro';
import Tag from './Tag.astro';

interface Props {
  title?: string; id?: string; href?: string; image?: string | Pic | (string | Pic)[]; date?: string | Date; subtitle?: string;
  links?: { text: string; href: string }[]; tags?: string[]; align?: 'vertical' | 'horizontal'; side?: 'left' | 'right';
  bare?: boolean; prose?: boolean; featured?: boolean; modal?: boolean; indent?: boolean;
}
const {
  title, id, href, image, date, subtitle, links = [], tags = [], align = 'vertical', side = 'left',
  bare = false, prose = false, featured = false, modal = false, indent,
} = Astro.props;

const pics = [image ?? []].flat().map((i) => (typeof i === 'string' ? findImage(i) : i));
const [cover, ...extra] = pics;
// A real date is formatted; anything else (a preformatted range) is shown as written
const isDate = date instanceof Date || (typeof date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(date));
const when = isDate ? new Date(date as string | Date) : undefined;
const link = href ? { href: url(href), ...externalAttrs(href) } : {};
const Root = href ? 'a' : 'div';
const hasBody = Astro.slots.has('default');
---
<Root id={id} class:list={['card', { 'not-prose': !prose || href, 'card-featured': featured, 'card-horizontal': align === 'horizontal', 'card-bare': bare }]} {...link} data-side={side} data-modal={modal ? '' : undefined} style={indent === undefined ? undefined : `--indent:${indent ? '2em' : '0'}`}>
  {cover && (
    <div class="card-media not-prose">
      <Image class="card-cover" {...imgProps(cover)} alt={title ?? ''} widths={[400, 800]} sizes="(min-width: 768px) 400px, 100vw" />
      <Gallery images={extra} alt={title ?? ''} />
    </div>
  )}
  <div class="card-content">
    {(title || date) && <div class="card-head not-prose">
      {title && <span class="card-title">{title}</span>}
      {date && <time class="card-date" datetime={when?.toISOString().slice(0, 10)}>{when ? formatDate(when) : date}</time>}
    </div>}
    {(subtitle || links.length > 0) && <div class="card-sub not-prose">
      {subtitle && <span class="card-subtitle">{subtitle}</span>}
      {links.map((l) => <a class="link accent-link" href={url(l.href)} {...externalAttrs(l.href)}>{l.text}</a>)}
    </div>}
    {hasBody && <div class={prose ? 'card-body' : 'card-summary'}><slot /></div>}
    {tags.length > 0 && <span class="card-meta not-prose">{tags.map((t) => <Tag name={t} />)}</span>}
  </div>
</Root>
