---
// <Projects folder="deda" cols={1} align="horizontal" alternate title="Projects" />
// Projects shown in full on this page, one card each: title, dates, course, links, images, and the whole write-up.
//   folder / ids / exclude: which projects (same as ProjectCards)
//   cols: cards per row on desktop (default 1)   align: horizontal (default, image beside the text) | vertical
//   alternate: swap the image side on every other card (default on, horizontal only)
import { render } from 'astro:content';
import { imageList, listProjects, projectDates, projectHref, isPage, slugOf, type List } from '../lib/projects';
import Grid from './Grid.astro';
import Card from './Card.astro';

interface Props {
  ids?: List; folder?: List; exclude?: List; title?: string; cols?: number;
  align?: 'horizontal' | 'vertical'; alternate?: boolean;
}
const { ids, folder, exclude, title, cols = 1, align = 'horizontal', alternate = true } = Astro.props;
const list = await listProjects({ ids, folder, exclude });
const items = await Promise.all(list.map(async (p) => ({ p, Content: (await render(p)).Content })));
const slug = title?.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const linksOf = (p: (typeof list)[number]) => [
  ...(p.data.repo ? [{ text: 'GitHub repo', href: p.data.repo }] : []),
  ...(isPage(p) ? [{ text: 'Project page', href: projectHref(p) }] : []),
];
---
{items.length > 0 && (
  <>
    {title && <h2 id={slug} class="section-heading">{title}</h2>}
    <Grid {cols} gap={32}>
      {items.map(({ p, Content }, i) => (
        <Card
          id={slugOf(p)} title={p.data.title} date={projectDates(p.data)} subtitle={p.data.course} links={linksOf(p)}
          image={imageList(p)} {align} side={alternate && i % 2 ? 'right' : 'left'} indent={p.data.indent || undefined} prose
        ><Content /></Card>
      ))}
    </Grid>
  </>
)}
