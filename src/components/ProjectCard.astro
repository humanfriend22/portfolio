---
import type { CollectionEntry } from 'astro:content';
import { imageList, projectHref } from '../lib/projects';
import { Image } from 'astro:assets';
import { imgProps } from '../lib/images';
import { url } from '../lib/url';
import Tag from './Tag.astro';

interface Props { project: CollectionEntry<'projects'>; featured?: boolean }
const { project: p, featured = false } = Astro.props;
const [cover] = imageList(p);
---
<a class:list={['card', { 'card-featured': featured }]} href={url(projectHref(p))} data-modal={p.data.modal ? '' : undefined}>
  {cover && <Image class="card-cover" {...imgProps(cover)} alt="" widths={[400, 800]} sizes="(min-width: 768px) 400px, 100vw" />}
  <span class="card-title">{p.data.title}</span>
  <span class="card-summary">{p.data.summary}</span>
  <span class="card-meta">{p.data.stack.map((s) => <Tag name={s} />)}</span>
</a>
