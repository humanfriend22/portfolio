---
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/transitions.css';
import { menu, site } from '../data/site';
import { externalAttrs } from '../lib/external';
import { pathWithoutBase, url } from '../lib/url';

interface Props { title?: string; description?: string; indent?: boolean }
const { title, description, indent = false } = Astro.props;

const cur = pathWithoutBase(Astro.url.pathname);
const isHome = cur === '/';
const parts = cur.split('/').filter(Boolean); // breadcrumbs
const isProjectPage = /^\/projects\/[^/]+\//.test(cur);
const isActive = (href: string) => !href.includes('#') && !href.startsWith('http') && cur.startsWith(href);
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{isHome || !title ? site.title : `${title} — ${site.title}`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <header class="site-header wrap">
      <div class="header-row">
        <a href={url('/')} class="crumbs">
          <span>humanfriend22</span>
          {isHome ? (
            <><span aria-hidden="true">/</span><span class="current">README.md</span></>
          ) : (
            parts.map((p, i) => (
              <>
                <span aria-hidden="true">/</span>
                {i === parts.length - 1 ? <span class="current">{p}.md</span> : <span>{p}</span>}
              </>
            ))
          )}
        </a>
        <nav class="desktop-nav" aria-label="Main">
          {menu.map((m) => <a href={url(m.url)} class={isActive(m.url) ? 'active' : undefined} {...externalAttrs(m.url)}>{m.name}</a>)}
        </nav>
        <button type="button" class="menu-button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
          <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Main">
        <div class="mobile-nav-clip">
          <div class="mobile-nav-grid">
            {menu.map((m) => <a href={url(m.url)} class={isActive(m.url) ? 'active' : undefined} {...externalAttrs(m.url)}>{m.name}</a>)}
          </div>
        </div>
      </nav>
    </header>
    <main class:list={['wrap page prose', { '[--indent:2em]': indent }]}><slot /></main>
    <dialog class="modal" aria-label="Project"><button class="modal-close" aria-label="Close">&times;</button><div class="modal-body page"></div></dialog>
    <footer class="site-footer wrap">
      <hr />
      <div class="footer-row">
        {isProjectPage ? <a class="link" href={url('/projects/')}>← all projects</a> : <span>© {new Date().getFullYear()} {site.title}</span>}
        <a class="link" href={site.github} {...externalAttrs(site.github)}>github.com/humanfriend22</a>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const button = header.querySelector<HTMLButtonElement>('.menu-button')!;

      function set(open: boolean) {
        header.toggleAttribute('data-open', open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      }

      button.addEventListener('click', () => set(!header.hasAttribute('data-open')));
      header.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
      header.querySelectorAll('.mobile-nav a').forEach((a) => a.addEventListener('click', () => set(false)));
    </script>

    <script>
      // Cards marked data-modal open the project in a dialog on desktop; on mobile (or with a modifier key) they navigate normally.
      const dialog = document.querySelector<HTMLDialogElement>('.modal')!;
      const body = dialog.querySelector('.modal-body')!;
      const desktop = window.matchMedia('(min-width: 768px)');

      dialog.querySelector('.modal-close')!.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
      document.addEventListener('click', (e) => {
        const card = (e.target as Element).closest<HTMLAnchorElement>('a.card[data-modal]');
        if (!card || !desktop.matches || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
        e.preventDefault();
        fetch(card.href)
          .then((r) => r.text())
          .then((html) => {
            const main = new DOMParser().parseFromString(html, 'text/html').querySelector('main')!;
            body.innerHTML = main.innerHTML;
            dialog.showModal();
            dialog.scrollTop = 0;
          })
          .catch(() => { location.href = card.href; });
      });
    </script>

    <script>
      // Open the accordion that contains the linked section (#projects, #inch-cubed, ...)
      function openTarget() {
        const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        const details = el && el.closest('details');
        if (details && !details.open) { details.open = true; el.scrollIntoView(); }
      }
      window.addEventListener('hashchange', openTarget);
      openTarget();
    </script>
  </body>
</html>
